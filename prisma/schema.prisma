generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIRECTOR
  STAFF
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          UserRole @default(DIRECTOR)
  cases         Case[]
  auditEntries  auditLedger[]
}

model Case {
  id                   String         @id @default(cuid())
  caseNumber           String         @unique @default(cuid())
  deceasedName         String
  deceasedFirstName    String?
  deceasedLastName     String?
  dateOfBirth          DateTime?
  dateOfDeath          DateTime       @default(now())
  locationOfTransition String?
  locationOfDeath      String?
  stage                String         @default("FIRST_CALL")
  status               String         @default("FIRST_CALL")
  
  directorId           String
  director             User           @relation(fields: [directorId], references: [id])
  
  disbursements        disbursement[]
  auditEntries         auditLedger[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model disbursement {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
}

model auditLedger {
  id        String   @id @default(cuid())
  action    String
  amount    Float?
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
